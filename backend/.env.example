ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL — self-hosted (Docker), open-source. See docs/architecture.md section 1.1.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/english_instructor

# LLM provider — ollama (padrão: local, open-source, $0) ou anthropic (pago, opção de troca)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Anthropic — https://console.anthropic.com (só usada se LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Azure AI Speech — https://portal.azure.com (Speech resource)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=en-US
AZURE_TTS_VOICE=en-US-AriaNeural

# Clerk — https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# <frontend-api-url>/.well-known/jwks.json, e.g. https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=["http://localhost:5173"]

DAILY_SESSION_LIMIT_MINUTES=30
