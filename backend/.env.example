ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# SQL Server — adjust driver name to what's installed locally (`odbcinst -j` / ODBC Data Sources)
DATABASE_URL=mssql+pyodbc://sa:YOUR_PASSWORD@localhost/EnglishInstructor?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Azure AI Speech — https://portal.azure.com (Speech resource)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Clerk — https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

DAILY_SESSION_LIMIT_MINUTES=30
